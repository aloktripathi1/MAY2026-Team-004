# DATABASE_URL points Prisma (app + CLI) at Docker Postgres.
# Start with: npm run db:up && npm run db:push && npm run db:seed

DATABASE_URL="postgresql://sangam:sangam@localhost:5432/sangam?schema=public"

NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Signs the session cookie (falls back to NEXTAUTH_SECRET, then an insecure
# dev-only default outside production). Required in production — the app
# refuses to sign sessions without it. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-string"

# Enables the login page's "preview a role" demo persona (privileged,
# no-login-required session). Never set this in production. Leave unset to
# keep protected routes requiring a real signed-in session.
ALLOW_DEMO_SESSION="true"

# Powers Ask Sangam (POST /api/assistant/query) via lib/genai.ts.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# --- Email (backend/email) ---------------------------------------------------

# Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Sender identity. The project's sending domain is sangam-club.com, verified in
# Resend. Use the onboarding sender below only before a domain is verified: it
# needs no DNS setup, but Resend will then deliver to the account owner alone.
#   verified:   "Sangam <no-reply@sangam-club.com>"
#   unverified: "Sangam <onboarding@resend.dev>"
EMAIL_FROM="Sangam <onboarding@resend.dev>"

# Where recipients' replies go. Optional — omit to let replies bounce, which is
# what a no-reply From address implies. Set it to a real mailbox if you'd rather
# replies reached someone.
EMAIL_REPLY_TO=""

# Master switch. Unset or "false" puts the mailer in dry-run: every send is
# logged to the console and recorded in EmailLog, but nothing leaves the app.
# Keep it off locally and in tests so development never mails real students.
EMAIL_ENABLED="false"

# Restricts real delivery to addresses matching these comma-separated patterns
# (full address, or a bare domain to match everyone on it). Anything else is
# skipped and logged; dry-run ignores it. This is the guard that keeps a
# 45-member announcement fan-out from reaching the seeded student addresses, so
# keep it set while testing and clear it only for a genuine production run.
EMAIL_ALLOWLIST="23f2005593@ds.study.iitm.ac.in"

# Absolute base URL used to build links inside emails. NEXTAUTH_URL is for
# auth callbacks and points at localhost in dev; this is what recipients click.
# Production serves from Vercel, so this stays the Vercel origin even though
# email now comes from sangam-club.com. Change it if the app moves.
#   production: "https://try-sangam.vercel.app"
APP_URL="http://localhost:3000"

# Refuses sign-in to accounts that haven't confirmed their email address, and
# stops signup from handing out a session before confirmation.
#
# Off by default on purpose. The gate is only safe once verification email
# actually reaches new signups — while EMAIL_ALLOWLIST is pinned, a student who
# signs up never receives a link and could never sign in. Enable it in the same
# change that clears EMAIL_ALLOWLIST. Accounts created before the feature are
# backfilled as verified by migration, so enabling it strands no existing login.
REQUIRE_EMAIL_VERIFICATION="false"

# Shared secret for the scheduled-email routes under /api/cron/*. Vercel Cron
# sends it as "Authorization: Bearer <CRON_SECRET>"; requests without it are
# rejected 401. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-string"
