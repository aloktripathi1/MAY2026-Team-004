// Prisma schema — SQLite (local dev only). Structurally mirrors schema.postgres.prisma,
// with two necessary divergences since SQLite lacks native enum and array types:
//   1. Every enum field becomes a plain `String`, validated at the Server Action layer (Zod).
//   2. Event.tags becomes a comma-joined `String` instead of a native array.
// Keep both schema files in sync by hand when adding/changing fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String
  rollNumber     String?  @unique
  image          String?
  interests      String   @default("[]")
  notificationPrefs String @default("{\"onlyMyClubs\":true,\"suggestedClubEvents\":true,\"pinnedAnnouncementsOnly\":false}")
  isFaculty      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships            Membership[]
  issuesRaised           Issue[]        @relation("IssueRaisedBy")
  issuesAssigned         Issue[]        @relation("IssueAssignee")
  tasksAssigned          Task[]
  contributions          Contribution[]
  announcementsAuthored  Announcement[]
  rsvps                  Rsvp[]
}

model Club {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  category    String // ClubCategory: Technical|Cultural|Sports|Entrepreneurship|Literary|Social|Design
  active      Boolean @default(true)
  hue         String
  emoji       String
  founded     String
  description String

  memberships          Membership[]
  events               Event[]
  announcements        Announcement[]
  venues               Venue[]
  equipment            Equipment[]
  transparencyEntries  TransparencyLogEntry[]
  issues               Issue[]
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     String   @default("Member") // ClubRole: Member|Volunteer|Coordinator|Admin
  status   String   @default("Active") // MembershipStatus: Active|Pending|Inactive
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  clubId      String
  date        DateTime
  time        String
  venue       String
  status      String   @default("upcoming") // EventStatus: upcoming|live|past
  capacity    Int
  cover       String
  tags        String // comma-joined (SQLite has no array type)
  description String
  approval    String   @default("pending") // ApprovalStatus: approved|pending|notRequired|rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tasks          Task[]
  contributions  Contribution[]
  rsvps          Rsvp[]
  transparencyEntries TransparencyLogEntry[]
}

model Rsvp {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  clubId    String
  authorId  String
  createdAt DateTime @default(now())
  pinned    Boolean  @default(false)
  audience  String   @default("All")

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  category    String // IssueCategory: Registration|Payment|Booking|Access|Other
  status      String   @default("Open") // IssueStatus: Open|InProgress|Resolved
  raisedById  String
  assigneeId  String?
  clubId      String?
  createdAt   DateTime @default(now())
  priority    String   @default("Low") // Priority: Low|Med|High
  attachments String   @default("[]") // JSON-encoded string[] — SQLite has no native array type

  raisedBy User  @relation("IssueRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  assignee User? @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  club     Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model Task {
  id         String    @id @default(cuid())
  title      String
  eventId    String
  role       String
  dueAt      DateTime?
  status     String    @default("todo") // TaskStatus: todo|doing|done
  priority   String    @default("Med") // Priority: Low|Med|High
  assigneeId String

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee User  @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  role        String
  hoursLogged Float
  verifiedAt  DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Venue {
  id           String  @id @default(cuid())
  name         String
  capacity     Int
  availability String
  clubId       String?

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model Equipment {
  id           String  @id @default(cuid())
  name         String
  quantity     Int
  availability String
  clubId       String?

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model TransparencyLogEntry {
  id         String  @id @default(cuid())
  eventName  String // display name; historical entries often predate the current Event rows
  eventId    String?
  outcome    String
  date       String
  clubId     String
  spend      String
  attendance String

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
}
